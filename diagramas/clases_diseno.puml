@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam packageStyle rectangle
skinparam nodesep 20
skinparam ranksep 60
left to right direction
hide circle
title Diagrama de clases de diseño - Ruta del Programador

package "vista" {
  class ConsolaApp {
    - ctrl : RutaController
    - in : Scanner
    - alumno : Alumno
    - mision : Mision
    + main(args : String[]) : void
    - exportarProgreso() : void
    - leerEntero(mensaje, min, max) : int
  }
}

package "controlador" {
  class RutaController {
    + PREGUNTAS_POR_CUESTIONARIO : int = 3
    + MINIMO_PARA_APROBAR : int = 2
    - pendientes : Queue<ActividadInteractiva>
    + RutaController(alumnoDAO, misionDAO, preguntaDAO, actividadDAO, progresoDAO)
    + alumnos() : List<Alumno>
    + misionesDe(alumno) : List<Mision>
    + cargarContenido(mision) : void
    + rendirCuestionario(alumno, mision, opciones) : ResultadoCuestionario
    + cuestionarioAprobado(alumno, mision) : boolean
    + iniciarActividades(alumno, mision) : int
    + actividadActual() : ActividadInteractiva
    + responder(respuesta) : ResultadoRespuesta
    + progresoPorNombre() : List<ResumenProgreso>
    + progresoPorMisiones() : List<ResumenProgreso>
    + buscarAlumno(nombre) : ResumenProgreso
    + progresoDe(alumno) : ResumenProgreso
    + exportarProgreso(alumno) : Path
  }
  class ResultadoCuestionario <<record>> {
    correctas : int
    aprobado : boolean
  }
  enum ResultadoRespuesta {
    CORRECTA
    INCORRECTA
    MISION_COMPLETADA
    SALIO
  }
}

package "modelo" {
  class Alumno {
    - id : int {final}
    - nombre : String
    - apellido : String
    - idFranja : int {final}
    + setNombre(nombre) : void
    + setApellido(apellido) : void
  }
  class Mision {
    - id : int {final}
    - mundo : String
    - titulo : String
    - leccion : String
    + setContenido(leccion, preguntas, actividades) : void
  }
  class Pregunta {
    - id : int {final}
    - enunciado : String
    - opciones : List<String>
    + esCorrecta(indice) : boolean
  }
  abstract class ActividadInteractiva {
    - id : int {final}
    - consigna : String
    - pista : String
    + {abstract} getInstrucciones() : String
    + {abstract} getElementos() : List<String>
    + {abstract} validar(respuesta) : boolean
  }
  class ActividadOrdenar {
    - elementos : List<String>
    - ordenCorrecto : List<Integer>
    + validar(respuesta) : boolean
  }
  class ActividadUnir {
    - izquierda : List<String>
    - derecha : List<String>
    + validar(respuesta) : boolean
  }
  class ActividadCompletar {
    - texto : String
    - opciones : List<String>
    - respuestaCorrecta : String
    + validar(respuesta) : boolean
  }
  class ResumenProgreso <<record>> {
    alumno : String
    misionesCompletadas : int
    promedioCuestionario : Double
  }
  class DetalleMision <<record>> {
    mision : String
    notaCuestionario : Integer
    completada : boolean
    fechaFinalizacion : LocalDateTime
    actividadesCorrectas : int
    actividadesTotales : int
  }
  class ContenidoInvalidoException {
    + ContenidoInvalidoException(mensaje)
    + ContenidoInvalidoException(mensaje, causa)
  }
  class PersistenciaException {
    + PersistenciaException(mensaje)
    + PersistenciaException(mensaje, causa)
  }
}

package "dao" {
  class ConexionBD {
    + {static} obtener() : Connection
  }
  interface AlumnoDAO <<interface>> {
    + listarActivos() : List<Alumno>
  }
  interface MisionDAO <<interface>> {
    + listarPorFranja(idFranja) : List<Mision>
    + obtenerLeccion(idMision) : String
  }
  interface PreguntaDAO <<interface>> {
    + listarPorMision(idMision) : List<Pregunta>
  }
  interface ActividadDAO <<interface>> {
    + listarPorMision(idMision) : List<ActividadInteractiva>
  }
  interface ProgresoDAO <<interface>> {
    + registrarCuestionario(idAlumno, idMision, correctas) : void
    + obtenerResultadoCuestionario(idAlumno, idMision) : Integer
    + registrarActividad(idAlumno, idMision, idActividad, correcta) : void
    + actividadesCorrectas(idAlumno, idMision) : List<Integer>
    + marcarCompletada(idAlumno, idMision) : void
    + resumenPorAlumno() : List<ResumenProgreso>
    + resumenDe(idAlumno) : ResumenProgreso
    + detallePorMision(idAlumno) : List<DetalleMision>
  }
  class AlumnoDAOJdbc
  class MisionDAOJdbc
  class PreguntaDAOJdbc
  class ActividadDAOJdbc {
    - crearActividad(tipo, ...) : ActividadInteractiva
  }
  class ProgresoDAOJdbc
}

package "util" {
  class Algoritmos <<utility>> {
    + {static} ordenarPorInsercion(lista, criterio) : void
    + {static} buscarBinario(lista, buscado, criterio) : int
  }
  class ExportadorCSV <<utility>> {
    + {static} SEPARADOR : String = ";"
    + {static} ENCABEZADOS : String[]
    + {static} armarFilas(detalle) : ArrayList<String[]>
    + {static} escribir(destino, encabezados, filas) : void
  }
}

ActividadOrdenar --|> ActividadInteractiva
ActividadUnir --|> ActividadInteractiva
ActividadCompletar --|> ActividadInteractiva
ContenidoInvalidoException --|> Exception
PersistenciaException --|> Exception

Mision "1" *-- "3" Pregunta
Mision "1" *-- "3..5" ActividadInteractiva

ConsolaApp --> RutaController : usa
ConsolaApp ..> ActividadInteractiva : solo la abstracta
note right of ConsolaApp
  Cableado: crea las cinco
  implementaciones ...DAOJdbc
  y se las inyecta a RutaController
end note

RutaController --> "1" AlumnoDAO : inyectado
RutaController --> "1" MisionDAO : inyectado
RutaController --> "1" PreguntaDAO : inyectado
RutaController --> "1" ActividadDAO : inyectado
RutaController --> "1" ProgresoDAO : inyectado
RutaController ..> Algoritmos : ordena y busca
RutaController ..> ExportadorCSV : exporta
RutaController --> "0..*" ActividadInteractiva : cola de pendientes
RutaController ..> ResultadoCuestionario
RutaController ..> ResultadoRespuesta

AlumnoDAOJdbc ..|> AlumnoDAO
MisionDAOJdbc ..|> MisionDAO
PreguntaDAOJdbc ..|> PreguntaDAO
ActividadDAOJdbc ..|> ActividadDAO
ProgresoDAOJdbc ..|> ProgresoDAO

AlumnoDAOJdbc ..> ConexionBD
MisionDAOJdbc ..> ConexionBD
PreguntaDAOJdbc ..> ConexionBD
ActividadDAOJdbc ..> ConexionBD
ProgresoDAOJdbc ..> ConexionBD

AlumnoDAOJdbc ..> Alumno : crea
MisionDAOJdbc ..> Mision : crea
PreguntaDAOJdbc ..> Pregunta : crea
ActividadDAOJdbc ..> ActividadInteractiva : crea (Factory)
ProgresoDAOJdbc ..> ResumenProgreso : crea
ProgresoDAOJdbc ..> DetalleMision : crea
ExportadorCSV ..> DetalleMision : lee

ProgresoDAO ..> PersistenciaException : lanza (los 5 DAO,\nenvolviendo la SQLException)

Mision ..> ContenidoInvalidoException : lanza
ActividadDAOJdbc ..> ContenidoInvalidoException : lanza
PreguntaDAOJdbc ..> ContenidoInvalidoException : lanza
@enduml
